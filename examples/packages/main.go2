pkg main;
import "fmt";
import "geometry";
import "text/count";

fn main[] {
    let p = geometry.Point[x = 3, y = 4];
    fmt.print("{}\n", p.dist2(geometry.origin()));
    let s = geometry.Shape.square[2];
    fmt.print("{}\n", geometry.area(s));
    match s {
        case square n { fmt.print("square {}\n", n); }
        else { fmt.print("other\n"); }
    }
    fmt.print("{}\n", count.vowels("packages and folders"));
    greet();
}
