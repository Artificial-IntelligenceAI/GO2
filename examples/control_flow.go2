pkg main;
import "fmt";

fn main[] {
    // if, else if, else; { may sit anywhere
    for n in -1..1 {
        if n > 0 {
            fmt.print("positive\n");
        } else if n < 0
        {
            fmt.print("negative\n");
        }
        else {
            fmt.print("zero\n");
        }
    }

    // for forever, left by stop
    var i = 0;
    for {
        i = i + 1;
        if i == 3 { stop; }
    }
    fmt.print("forever stopped at {}\n", i);

    // for while a condition holds; next skips to the next turn
    var j = 0;
    var odd = 0;
    for j < 10 {
        j = j + 1;
        if j % 2 == 0 { next; }
        odd = odd + j;
    }
    fmt.print("odd sum {}\n", odd);

    // a range includes both ends; a range running down is empty
    var sum = 0;
    for k in 1..10 { sum = sum + k; }
    fmt.print("1..10 sums to {}\n", sum);
    for k in 5..1 { fmt.print("never {}\n", k); }

    // a range ending at its type's last value stops there, without overflowing
    var count = 0;
    let top: u8 = 255;
    for b in 250..top { count = count + 1; }
    fmt.print("{} values to 255\n", count);

    // stop and next act on the innermost loop
    for a in 1..3 {
        for b in 1..3 {
            if b == 2 { next; }
            if a == 3 { stop; }
            fmt.print("{}{} ", a, b);
        }
    }
    fmt.print("\n");
}
